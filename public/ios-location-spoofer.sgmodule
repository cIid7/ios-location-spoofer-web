#!name=iOS Location Spoofer (Self-Hosted)
#!desc=拦截 Apple 定位服务器回应的 GPS 坐标，替换成自定义位置。【免费开源/严禁倒卖】唯一开源仓库: https://github.com/akudamatata/iOS-Location-Spoofer-Web
#!homepage=https://github.com/akudamatata/iOS-Location-Spoofer-Web
#!author=akudamatata

[Script]
iOS Location Spoofer = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,timeout=10,script-path=https://https://ios-location-spoofer-web-7tk.pages.dev/location-spoofer.js,argument=mode=response&configUrl=/ios-location-spoofer.sgmodule?token=8ee03cb0300e699b3f9d3059d2b825f1

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com